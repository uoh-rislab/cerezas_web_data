# Copiar como .env. Nunca versionar el archivo .env real.
CEREZAS_DATA_HOST_PATH=/home/uoh/cerezas_web_server/data/climate-reporting
CEREZAS_CONFIG_HOST_PATH=/home/uoh/cerezas_web_server/config/climate-reporting

MONGO_USER=uoh_cerezas
MONGO_PASSWORD=cambiar_en_el_servidor
# Alternativamente se puede definir una URI completa y omitir las dos variables anteriores:
# MONGO_URI=mongodb://usuario:password@127.0.0.1:27017/?authSource=admin
